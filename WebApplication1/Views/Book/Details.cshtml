@model WebApplication1.ViewModels.BookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<div class="container py-5 details-page">
    <a asp-action="Index" class="back-link">← Back</a>

    <div class="date-line mb-2">@Model.CurrentDate</div>

    <h1 class="page-title">Book Details</h1>
    <p class="page-subtitle">Full information for this book.</p>

    <div class="details-card">
        <div class="detail-item">
            <div class="detail-label">TITLE</div>
            <div class="detail-value">@Model.Title</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">AUTHOR</div>
            <div class="detail-value">@Model.AuthorName</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">ISBN</div>
            <div class="detail-value">@Model.ISBN</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">CATEGORY</div>
            <div class="detail-value">@Model.CategoryName</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">YEAR</div>
            <div class="detail-value">@Model.PublishYear</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">PRICE</div>
            <div class="detail-value">@Model.Price</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">IS RESTRICTED</div>
            <div class="detail-value">@Model.IsRestricted</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">STATUS</div>
            <div class="detail-value">
                <book-availability status="@Model.Status" is-restricted="@Model.IsRestricted"></book-availability>
            </div>
        </div>

        <div class="detail-item">
            <div class="detail-label">ATTACHMENTS</div>
            <div class="detail-value">
                @if (Model.Attachments.Any())
                {
                    <ul class="mb-0">
                        @foreach (var file in Model.Attachments)
                        {
                            <li>
                                <a href="@file.FilePath" target="_blank">@file.FileName</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <span>No attachments</span>
                }
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h3 class="mb-3">Book Card</h3>

        <partial name="Partials/_BookCardPartial"
                 model='new BookCardDto
                 {
                     Id = Model.Id,
                     Title = Model.Title,
                     AuthorName = Model.AuthorName,
                     CategoryName = Model.CategoryName,
                     PublishYear = Model.PublishYear,
                     Price = Model.Price,
                     Status = Model.Status,
                     IsRestricted = Model.IsRestricted,
                     AttachmentsCount = Model.Attachments.Count
                 }' />
    </div>

    <div class="mt-5">
        @await Component.InvokeAsync("RelatedBooks", new
                {
            currentBookId = Model.Id,
                categoryId = Model.CategoryId,
                authorId = Model.AuthorId,
                publishYear = Model.PublishYear
                })
    </div>
</div>